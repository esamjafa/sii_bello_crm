generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ACCOUNTANT
  RECEPTIONIST
  SALES
  COLLEGE
  TRAINER
  EVENT_MANAGER
  INVENTORY
  GOD
  ADMIN
  MANAGER
  STAFF
  VIEWER
  CUSTOMER
}
enum AppointmentStatus {
  PENDING_REPLY
  CONFIRMED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}
enum ExpenseStatus {
  DUE
  PAID
}

model User {
  staffId String? @unique
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  assignedCustomers Customer[] @relation("CustomerOwner")
  tasks Task[] @relation("TaskOwner")
  managedEvents Event[]
  courses CollegeCourse[]
  sessionVersion Int @default(0)
  id String @id @default(cuid())
  username String @unique
  email String? @unique
  name String
  passwordHash String
  role Role @default(STAFF)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  dailyLockCount Int @default(0)
  lockCountDate String?
  requiresGodUnlock Boolean @default(false)
  customerId String? @unique
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  auditLogs AuditLog[]
  reviewedRequests ServiceRequest[] @relation("ReviewedBy")
}

model Customer {
  catalogueInterests Json?
  gender String?
  preferredServiceId String?
  servicePreferences Json?
  consents ConsentRecord[]
  city String?
  country String @default("IL")
  departments String[] @default(["SALON"])
  source String @default("OTHER")
  ownerId String?
  owner User? @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastContactAt DateTime?
  archivedAt DateTime?
  allergies String?
  photoConsent Boolean @default(false)
  serviceConsent Boolean @default(false)
  careInstructions String?
  interestedIn String?
  tasks Task[]
  entries CustomerNote[]
  documents CustomerDocument[]
  students Student[]
  eventLeads EventLead[]
  hairSessions HairSession[]
  stockMovements StockMovement[]
  @@index([ownerId, archivedAt])
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  notes String?
  followUpAt DateTime?
  lastVisitAt DateTime?
  relationshipStatus String @default("NEW")
  createdAt DateTime @default(now())
  appointments Appointment[]
  invoices Invoice[]
  laserPlans LaserPlan[]
  user User?
  serviceRequests ServiceRequest[]
}

model Service {
  onlineBookable Boolean @default(false)
  imageUrl String?
  bufferMinutes Int @default(0)
  resourceKey String?
  configuration Json?
  department String @default("SALON")
  id String @id @default(cuid())
  name String
  price Decimal
  durationMinutes Int @default(60)
  active Boolean @default(true)
  appointments Appointment[]
  invoices Invoice[]
  serviceRequests ServiceRequest[]
}

model ServiceRequest {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  serviceId String
  service Service @relation(fields:[serviceId], references:[id], onDelete:Restrict)
  preferredAt DateTime
  notes String?
  status String @default("PENDING")
  adminNote String?
  reviewedAt DateTime?
  reviewedById String?
  reviewedBy User? @relation("ReviewedBy", fields:[reviewedById], references:[id], onDelete:SetNull)
  appointmentId String? @unique
  invoiceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([customerId])
}

model WorkingHour {
  id String @id @default(cuid())
  dayOfWeek Int @unique
  openTime String
  closeTime String
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model BookingVerification {
  id String @id @default(cuid())
  phone String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields:[actorId], references:[id], onDelete:SetNull)
  actorName String
  actorRole String
  action String
  entity String
  entityId String?
  details String?
  ipAddress String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([actorId])
  @@index([action, entity, entityId])
}

model NotificationLog {
  id String @id @default(cuid())
  serviceRequestId String?
  channel String
  recipient String
  event String
  status String
  providerId String?
  error String?
  createdAt DateTime @default(now())
  @@index([serviceRequestId])
  @@index([createdAt])
}

model Staff {
  department String @default("SALON")
  services String[] @default([])
  schedule String?
  commissionRate Decimal @default(0)
  user User?
  leaves EmployeeLeave[]
  hairSessions HairSession[]
  id String @id @default(cuid())
  name String
  phone String?
  email String?
  title String?
  active Boolean @default(true)
  appointments Appointment[]
  laserSessions LaserSession[]
}

model Appointment {
  documents CustomerDocument[]
  @@index([resourceKey, startsAt])
  serviceDetails Json?
  priceSnapshot Json?
  resourceKey String?
  bufferMinutes Int @default(0)
  durationMinutes Int?
  price Decimal?
  archivedAt DateTime?
  nextFollowUpAt DateTime?
  sessionNotes String?
  invoiceId String? @unique
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  serviceId String
  service Service @relation(fields:[serviceId], references:[id], onDelete:Restrict)
  staffId String?
  staff Staff? @relation(fields:[staffId], references:[id], onDelete:SetNull)
  startsAt DateTime
  status AppointmentStatus @default(SCHEDULED)
  notes String?
  createdAt DateTime @default(now())
  @@index([startsAt])
}

model Invoice {
  notes String?
  documents CustomerDocument[]
  originalAmount Decimal @default(0)
  discount Decimal @default(0)
  discountReason String?
  currency String @default("ILS")
  department String @default("SALON")
  cancelledAt DateTime?
  cancelReason String?
  payments Payment[]
  appointment Appointment?
  enrollment StudentEnrollment?
  eventLead EventLead?
  stockMovements StockMovement[]
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  serviceId String?
  service Service? @relation(fields:[serviceId], references:[id], onDelete:SetNull)
  description String
  amount Decimal
  paidAmount Decimal @default(0)
  status InvoiceStatus @default(UNPAID)
  dueAt DateTime?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Expense {
  id String @id @default(cuid())
  payee String
  category String
  description String
  amount Decimal
  dueAt DateTime
  paidAt DateTime?
  status ExpenseStatus @default(DUE)
  createdAt DateTime @default(now())
  @@index([dueAt])
}

model CollegeCourse {
  coordinatorId String?
  trainerId String?
  trainer User? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  groupName String?
  startsAt DateTime?
  endsAt DateTime?
  hours Int @default(0)
  capacity Int @default(20)
  includedKit String?
  cost Decimal @default(0)
  status String @default("UPCOMING")
  sessions CourseSession[]
  id String @id @default(cuid())
  title String
  category String @default("COSMETIC")
  fee Decimal @default(0)
  description String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  enrollments StudentEnrollment[]
}

model Student {
  requiredDocuments String[] @default([])
  receivedDocuments String[] @default([])
  collegeService String @default("CONSULTATION")
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  interestedCourse String?
  interest String @default("MEDIUM")
  objection String?
  quotedPrice Decimal @default(0)
  offeredDiscount Decimal @default(0)
  notRegisteredReason String?
  archivedAt DateTime?
  @@index([customerId])
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  status String @default("NEW")
  followUpAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  enrollments StudentEnrollment[]
  contacts StudentContact[]
}

model StudentEnrollment {
  status String @default("REGISTERED")
  invoiceId String? @unique
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  certificateStatus String @default("PENDING")
  kitReceivedAt DateTime?
  trainerNotes String?
  attendance Attendance[]
  archivedAt DateTime?
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Restrict)
  courseId String
  course CollegeCourse @relation(fields:[courseId], references:[id], onDelete:Restrict)
  fee Decimal
  enrolledAt DateTime @default(now())
  notes String?
  payments StudentPayment[]
  @@index([studentId])
}

model StudentPayment {
  voidedAt DateTime?
  voidReason String?
  id String @id @default(cuid())
  enrollmentId String
  enrollment StudentEnrollment @relation(fields:[enrollmentId], references:[id], onDelete:Restrict)
  amount Decimal
  paidAt DateTime @default(now())
  method String @default("CASH")
  notes String?
  @@index([enrollmentId])
}

model StudentContact {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Restrict)
  contactedAt DateTime @default(now())
  channel String @default("PHONE")
  outcome String
  notes String?
  nextFollowUpAt DateTime?
  @@index([studentId])
}

model Event {
  capacity Int @default(0)
  managerId String?
  manager User? @relation(fields: [managerId], references: [id], onDelete: SetNull)
  currency String @default("AED")
  depositRequired Decimal @default(0)
  archivedAt DateTime?
  id String @id @default(cuid())
  name String
  location String?
  startsAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  packages EventPackage[]
  leads EventLead[]
}

model EventPackage {
  id String @id @default(cuid())
  eventId String?
  event Event? @relation(fields:[eventId], references:[id], onDelete:SetNull)
  name String
  price Decimal
  description String?
  active Boolean @default(true)
  leads EventLead[]
}

model EventLead {
  partySize Int @default(1)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId String? @unique
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  originalPrice Decimal @default(0)
  discount Decimal @default(0)
  discountReason String?
  currency String @default("AED")
  nextPaymentAt DateTime?
  vip Boolean @default(false)
  flight Boolean @default(false)
  flightDetails String?
  transferDetails String?
  hotel Boolean @default(false)
  hotelName String?
  roomType String?
  companion String?
  certificate Boolean @default(false)
  certificateStatus String @default("PENDING")
  specialNeeds String?
  attended Boolean @default(false)
  archivedAt DateTime?
  @@index([customerId])
  id String @id @default(cuid())
  eventId String?
  event Event? @relation(fields:[eventId], references:[id], onDelete:SetNull)
  packageId String?
  package EventPackage? @relation(fields:[packageId], references:[id], onDelete:SetNull)
  name String
  phone String
  region String @default("LOCAL")
  stage String @default("NEW")
  agreedAmount Decimal @default(0)
  paidAmount Decimal @default(0)
  followUpAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  contacts EventContact[]
  @@index([region, stage])
}

model EventContact {
  id String @id @default(cuid())
  leadId String
  lead EventLead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  contactedAt DateTime @default(now())
  channel String @default("PHONE")
  outcome String
  notes String?
  nextFollowUpAt DateTime?
  @@index([leadId])
}

model LaserPlan {
  registrationKey String? @unique
  catalogueSelection Json?
  category String @default("LASER")
  price Decimal @default(0)
  archivedAt DateTime?
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  area String
  sessionsTotal Int
  consentNotes String?
  followUpAt DateTime?
  startedAt DateTime @default(now())
  sessions LaserSession[]
  documents LaserDocument[]
  @@index([customerId])
}

model LaserSession {
  device String?
  settings String?
  skinHairNotes String?
  contraindications String?
  nextSessionAt DateTime?
  archivedAt DateTime?
  id String @id @default(cuid())
  planId String
  plan LaserPlan @relation(fields:[planId], references:[id], onDelete:Restrict)
  staffId String?
  staff Staff? @relation(fields:[staffId], references:[id], onDelete:SetNull)
  performedAt DateTime @default(now())
  notes String?
  @@index([planId])
}

model LaserDocument {
  id String @id @default(cuid())
  planId String
  plan LaserPlan @relation(fields:[planId], references:[id], onDelete:Restrict)
  filename String
  mimeType String
  content Bytes
  createdAt DateTime @default(now())
  @@index([planId])
}

model Task {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contactedAt DateTime @default(now())
  channel String @default("PHONE")
  reason String
  summary String?
  outcome String @default("NEW")
  nextAction String?
  dueAt DateTime?
  priority String @default("NORMAL")
  completedAt DateTime?
  archivedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, dueAt, completedAt])
  @@index([customerId])
}
model CustomerNote {
  department String @default("SALON")
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  body String
  authorId String
  authorName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CustomerDocument {
  appointmentId String?
  appointment Appointment? @relation(fields:[appointmentId], references:[id], onDelete:Restrict)
  invoiceId String?
  invoice Invoice? @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
  department String @default("SALON")
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  filename String
  mimeType String
  content Bytes
  category String @default("DOCUMENT")
  authorId String
  createdAt DateTime @default(now())
  @@index([customerId])
}

model ConsentRecord {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  purpose String
  granted Boolean
  actorId String
  recordedAt DateTime @default(now())
  note String
  @@index([customerId, purpose, recordedAt])
}
model Payment {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount Decimal
  kind String @default("PAYMENT")
  paidAt DateTime @default(now())
  method String @default("CASH")
  receivedById String?
  notes String?
  receiptDocumentId String?
  voidedAt DateTime?
  voidedById String?
  voidReason String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([invoiceId, paidAt])
}
model Product {
  sku String? @unique
  onlineVisible Boolean @default(false)
  imageBytes Bytes?
  imageMime String?
  id String @id @default(cuid())
  name String
  imageUrl String?
  category String
  supplier String?
  purchasePrice Decimal @default(0)
  salePrice Decimal @default(0)
  currency String @default("ILS")
  minimum Int @default(0)
  storageLocation String?
  purpose String @default("SALE")
  archivedAt DateTime?
  movements StockMovement[]
  orders SupplierOrder[]
}
model StockMovement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId String?
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind String
  quantity Int
  batch String
  expiresAt DateTime?
  reason String
  actorId String
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([productId, batch])
}
model SupplierOrder {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier String
  quantity Int
  expectedAt DateTime
  status String @default("PENDING")
  notes String?
}
model CourseSession {
  id String @id @default(cuid())
  courseId String
  course CollegeCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title String
  startsAt DateTime
  endsAt DateTime
  attendance Attendance[]
}
model Attendance {
  id String @id @default(cuid())
  sessionId String
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollmentId String
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  status String @default("PRESENT")
  grade Int?
  notes String?
  @@unique([sessionId, enrollmentId])
}
model HairSession {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staffId String?
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service String
  diagnosis String?
  materials String?
  quantities String?
  result String?
  homeCare String?
  performedAt DateTime @default(now())
  renewalAt DateTime?
  archivedAt DateTime?
}
model EmployeeLeave {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  reason String
  status String @default("PENDING")
}
model MessageTemplate {
  id String @id @default(cuid())
  name String
  body String
  department String @default("SALON")
  active Boolean @default(true)
}
model Reminder {
  id String @id @default(cuid())
  taskId String
  dueAt DateTime
  status String @default("PENDING")
  attemptedAt DateTime?
  error String?
  @@unique([taskId, dueAt])
}
