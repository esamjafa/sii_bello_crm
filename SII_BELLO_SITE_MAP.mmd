flowchart RL
  ROOT["Sii Bello"] --> PUBLIC["واجهة العميلات /book"]
  ROOT --> LOGIN["دخول الموظفات /login"]
  LOGIN --> CRM["لوحة العمل / — حسب الصلاحية"]
  CRM --> HOME["الرئيسية: اليوم، المتأخر، المواعيد، الدفعات"]
  CRM --> CUSTOMERS["العميلات: بحث بالهاتف ومنع التكرار"]
  CUSTOMERS --> PROFILE["ملف العميلة الموحد"]
  PROFILE --> SUMMARY["الملخص والمواعيد والخدمات"]
  PROFILE --> FOLLOW["المتابعات والملاحظات"]
  PROFILE --> MONEY["الفواتير والدفعات — حسب الصلاحية"]
  PROFILE --> FILES["الصور والمستندات المرتبطة بالقسم والجلسة"]
  PROFILE --> CONSENT["موافقة التسويق + موافقة نشر الصور + سجل السحب"]
  PROFILE --> HISTORY["سجل التغييرات — الإدارة"]
  CRM --> TASKS["المتابعات والمهام: اليوم، المتأخر، الموظفة"]
  CRM --> SALON["الصالون"]
  SALON --> DAILY["جدول اليوم والتأكيد والمتابعة"]
  SALON --> CATALOGUE["القسم ثم بطاقات الخدمات: صورة + اسم + سعر + مدة"]
  CATALOGUE --> SERVICEDETAIL["تفاصيل الخدمة: لوحة جانبية، تكبير، حجز حسب الصلاحية"]
  SERVICEDETAIL -.-> FULLWORKFLOW["تسجيل أولي ← جلسة مستقلة ← إغلاق ومتابعة لكل خدمة — متبقٍ"]
  CATALOGUE --> LASER["الليزر: رسم أمام/خلف + مناطق + عروض اختيارية"]
  LASER --> GENDER["أنثى/ذكر: اللحية للرجال فقط، منع تداخل المناطق المسعرة"]
  LASER -.-> REGIONSESSION["تقييم الشعر وإعدادات فعلية مستقلة لكل منطقة ومقارنة الجلسات — متبقٍ"]
  CATALOGUE -.-> SPECIALFORMS["نماذج الحواجب والشمع والهوبي والأظافر والمكياج والبيرسينج والزركون — متبقٍ"]
  CATALOGUE --> HAIR["الشعر: قص/صبغة/علاج/كيراتين/وصلات"]
  HAIR --> COLOR["اللون والدرجة للصبغة فقط"]
  CATALOGUE --> SKIN["البشرة: تنظيف/تقشير/بخار/قناع"]
  CATALOGUE --> MASSAGE["المساج والخدمات الإضافية"]
  SALON --> APPOINTMENTS["المواعيد: العميلة والخدمة والموظفة والحالة"]
  APPOINTMENTS --> QUALIFICATIONS["التحقق من المهارة والدوام والإجازة"]
  APPOINTMENTS --> RESOURCE["منع تعارض الموظفة والجهاز/الغرفة والفاصل"]
  APPOINTMENTS --> SNAPSHOT["سجل الخدمة المنفذة والأسعار والمناطق والعرض"]
  SALON --> SESSIONS["باقات الليزر والجلسات وسجل الشعر"]
  CRM --> COLLEGE["الكلية"]
  COLLEGE --> COURSES["الدورات والمجموعات والمدربات والحضور"]
  COLLEGE --> STUDENTS["المهتمات والطالبات والأوراق والشهادات"]
  STUDENTS -.-> ENROLLMENTSUMMARY["دورة مختارة: الدفع والحضور والتقدم ودروسها فقط — متبقٍ"]
  COLLEGE --> COLLEGEMONEY["دفعات التسجيل والمتابعة"]
  COLLEGE -.-> CONTACTS["أرقام التواصل القابلة للإدارة — متبقٍ"]
  CRM --> EVENTS["الفعاليات"]
  EVENTS --> EVENTFILE["ملف الفعالية والباقات والمقاعد"]
  EVENTS --> LEADS["المهتمات والتسجيلات والمتابعات"]
  EVENTS --> TRAVEL["الفندق والطيران والمرافقة والمستندات"]
  LEADS -.-> CONTACTSTATES["التواصل والشرح والتسجيل والدفع مستقلة وتأجيل بمسؤولة ووقت — متبقٍ"]
  EVENTS -.-> EVENTNEW["فعالية قادمة افتراضية ودبي وتوقيت الموقع — متبقٍ"]
  CRM --> STOCK["المنتجات والمخزون"]
  STOCK --> PRODUCTS["المنتج ورمزه والمورد والصورة والسعر"]
  STOCK --> MOVEMENTS["الحركات والتشغيلة والانتهاء والحد الأدنى"]
  STOCK --> SUPPLIERS["طلبات الموردين"]
  STOCK -.-> DEVELOPMENT["منتجات العلامة: فكرة وعينات واختبار وتغليف وتشغيلة وإطلاق — متبقٍ"]
  STOCK -.-> RESERVATION["الموجود والمحجوز والمتاح وتحويل الوحدات والمرتجع الصالح — متبقٍ"]
  CRM --> PAYMENTS["المدفوعات والفواتير"]
  PAYMENTS --> INVOICE["إنشاء فاتورة وخصم وعملة ودفعات وإيصالات"]
  PAYMENTS --> EXPENSES["المصروفات"]
  EXPENSES -.-> OCR["استخراج فاتورة مصورة + مراجعة إلزامية — متبقٍ"]
  CRM --> STAFF["الموظفات"]
  STAFF --> SHIFTS["فترات الدوام والإجازات والمهارات"]
  STAFF -.-> MULTIROLE["تعدد الأدوار المقيدة — متبقٍ"]
  CRM --> REPORTS["التقارير المالية حسب العملة والصلاحية"]
  REPORTS -.-> PROFIT["ربح الخدمة بعد اكتمال بيانات التكلفة — متبقٍ"]
  CRM --> SETTINGS["الإعدادات والصلاحيات وسجل المراقبة"]
  SETTINGS -.-> INTEGRATIONS["إدارة التكاملات وآخر مزامنة والأخطاء — متبقٍ"]
  INTEGRATIONS -.-> ADS["Meta / Google: العملاء المحتملون والحملات"]
  INTEGRATIONS -.-> WA["WhatsApp Business Platform: المحادثات"]
  WA -.-> REMINDERS["تذكير وتأكيد وتأجيل وإلغاء وسجل تسليم ومراجعة الرد المبهم — متبقٍ"]
  CRM -.-> CONTENTPLAN["المحتوى: تقويم واقتراحات وموافقة وجدولة حسب الربط — متبقٍ"]
  REPORTS -.-> PROMOTIONS["محرك عروض مشترك ونتائج فعلية وتوصيات قابلة للاعتماد — متبقٍ"]
  INTEGRATIONS -.-> GATEWAY["بوابة الدفع: حساب النشاط والعربون"]
  PUBLIC --> BOOK["اختيار القسم والخدمة والسعر"]
  BOOK --> LASER
  BOOK --> SLOTS["عرض الأوقات المفتوحة والموظفات المؤهلات"]
  SLOTS -.-> HOLD["حجز مؤقت للموعد أثناء الدفع — متبقٍ"]
  HOLD -.-> CHECKOUT["الاسم والهاتف والعربون أو المبلغ الكامل — متبقٍ"]
  CHECKOUT -.-> CONFIRM["تأكيد موثوق من بوابة الدفع — متبقٍ"]
  CONFIRM -.-> APPOINTMENTS
  PUBLIC --> SHOP["المنتجات المنشورة والكمية والسلة"]
  SHOP -.-> ORDER["خصم واستلام/توصيل وطلب شراء — متبقٍ"]
  ORDER -.-> CONFIRM
  CONFIRM -.-> SETTLE["تسجيل الدفع وخصم المخزون مرة واحدة — متبقٍ"]
  SETTINGS --> BACKUP["نسخ احتياطي واسترجاع مُختبر يدويًا"]
  BACKUP -.-> PERIODIC["جدولة النسخ والتصدير والتنظيف — متبقٍ"]
