# Copy to .env.postgres.local. Never commit that local file.
# Runtime/pool URL supplied by your hosted PostgreSQL provider:
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/DATABASE?sslmode=require"
# Connection supported for migrations and a long data-transfer transaction:
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
